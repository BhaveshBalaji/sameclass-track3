            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/syllabus/text": {
      "get": {
        "tags": [
          "syllabus"
        ],
        "summary": "Syllabus Text",
        "operationId": "syllabus_text_api_syllabus_text_get",
        "parameters": [
          {
            "name": "class_nbr",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,6}$",
              "title": "Class Nbr"
            }
          },
          {
            "name": "term",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{3}[147]$",
              "title": "Term"
            }
          },
          {
            "name": "max_chars",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500000,
              "minimum": 100,
              "default": 100000,
              "title": "Max Chars"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/syllabus/lookup": {
      "get": {
        "tags": [
          "syllabus"
        ],
        "summary": "Syllabus Lookup",
        "description": "Current syllabus, older same instructor, then other instructors.\n\nOmit fallback_terms for six prior semesters, or supply comma-separated term\ncodes; an empty string disables historical lookup. Every fallback is labeled.",
        "operationId": "syllabus_lookup_api_syllabus_lookup_get",
        "parameters": [
          {
            "name": "term",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{3}[147]$",
              "title": "Term"
            }
          },
          {
            "name": "subject",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,5}$",
              "title": "Subject"
            }
          },
          {
            "name": "catalog_nbr",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,3}[A-Za-z]?$",
              "title": "Catalog Nbr"
            }
          },
          {
            "name": "professor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "default": "",
              "title": "Professor"
            }
          },
          {
            "name": "fallback_terms",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 60
                },
                {
                  "type": "null"
                }
              ],
              "title": "Fallback Terms"
            }
          },
          {
            "name": "max_pages",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 3,
              "minimum": 1,
              "default": 2,
              "title": "Max Pages"
            }
          },
          {
            "name": "include_text",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Include Text"
            }
          },
          {
            "name": "max_chars",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500000,
              "minimum": 100,
              "default": 100000,
              "title": "Max Chars"
            }
          },
          {
            "name": "budget_seconds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 120,
              "minimum": 1,
              "default": 90,
              "title": "Budget Seconds"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyllabusResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Meeting": {
        "properties": {
          "days": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Days"
          },
          "start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date"
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Date"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "unknown"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "days",
          "start",
          "end",
          "start_date",
          "end_date",
          "status"
        ],
        "title": "Meeting"
      },
      "SearchResponse": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "total": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Total"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/Section"
            },
            "type": "array",
            "title": "Results"
          },
          "scroll_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scroll Id"
          },
          "pages_fetched": {
            "type": "integer",
            "title": "Pages Fetched"
          },
          "complete": {
            "type": "boolean",
            "title": "Complete"
          },
          "stop_reason": {
            "type": "string",
            "title": "Stop Reason"
          },
          "retrieved_at": {
            "type": "string",
            "title": "Retrieved At"
          }
        },
        "type": "object",
        "required": [
          "count",
          "total",
          "results",
          "scroll_id",
          "pages_fetched",
          "complete",
          "stop_reason",
          "retrieved_at"
        ],
        "title": "SearchResponse"
      },
      "Section": {
        "properties": {
          "course": {
            "type": "string",
            "title": "Course"
          },
          "subject": {
            "type": "string",
            "title": "Subject"
          },
          "catalog_nbr": {
            "type": "string",
            "title": "Catalog Nbr"
          },
          "class_nbr": {
            "type": "string",
            "title": "Class Nbr"
          },
          "course_id": {
            "type": "string",
            "title": "Course Id"
          },
          "term": {
            "type": "string",
            "title": "Term"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "instructors": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Instructors"
          },
          "meeting_intervals": {
            "items": {
              "$ref": "#/components/schemas/Meeting"
            },
            "type": "array",
            "title": "Meeting Intervals"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
