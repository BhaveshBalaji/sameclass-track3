# Copy to an ignored root .env only if it does not already exist.
# Existing environment variables take precedence over the local file.
NODE_ENV=development

# Local-only development credentials for compose.yaml; never use them in deployment.
DATABASE_URL=postgresql://ray:ray_local_only@127.0.0.1:55432/ray
DB_POOL_MAX=3
ASU_API_BASE_URL=http://127.0.0.1:8000
RMP_API_BASE_URL=http://127.0.0.1:8001
API_TIMEOUT_MS=10000

# Required for live planning extraction and explicit model checks.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_PROVIDER=relace
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_REQUIRE_PARAMETERS=true
# none passed the bounded capability probe; retest each role before enabling reasoning.
OPENROUTER_REASONING_EFFORT=none
MODEL_TIMEOUT_MS=45000

# Required to connect Ray to your private development server.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_PLANNING_CHANNEL_IDS=

# Bounded context and group size (maximum 12 participants in this version).
PLANNING_MAX_MESSAGES=100
PLANNING_MAX_CHARACTERS=30000
PLANNING_MAX_PARTICIPANTS=12

# Later: configure the Supabase DB URL and private /asu and /rmp backend base URLs.
# For containerized bot processes use service DNS rather than host 127.0.0.1.
