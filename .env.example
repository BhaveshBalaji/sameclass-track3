# Proposed bot settings; the bot configuration loader is not implemented yet.
# Set the real key only in an ignored local .env file or the deployment's secrets.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_PROVIDER=relace
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_REQUIRE_PARAMETERS=true

# Proposed local bot/backend settings; the configuration loader is not implemented yet.
# Replace USER/PASSWORD with your local Postgres settings in the ignored .env file.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/sameclass
ASU_API_BASE_URL=http://127.0.0.1:8000
RMP_API_BASE_URL=http://127.0.0.1:8001
# Later deployment: set hosted secrets, the Supabase database URL and private API base URLs.
# Keep the same application code and migrations; use container DNS if running inside Compose.
